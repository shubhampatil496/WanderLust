<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<div class="row mt-3">
    <div class="col-8 offset-2">
        <br><br>
    <h3>Add New Listing</h3><br>

    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="Listing[title]" class="form-label">Title</label>
            <input type="text" name="Listing[title]" placeholder="Enter Title" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a valid title.
                </div>
        </div>
        <div class="mb-3">
            <label for="Listing[description]">Description</label>
            <textarea class="form-control" name="Listing[description]" placeholder="Enter Description" required></textarea>
                <div class="invalid-feedback">
                    Please provide a valid Description.
                </div>
        </div>
    

        <!-- upload image file -->
         <div class="mb-3">
            <label for="Listing[image]">Upload Image</label>
            <input type="file" name="Listing[image]" class="form-control">
        </div>

     <div class="row">
           <div class="mb-3 col-md-4">
            <label for="Listing[price]">Price</label>
            <input type="number" name="Listing[price]" placeholder="Enter Price" class="form-control" required>
                <div class="invalid-feedback">
                    Enter Price.
                </div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="Listing[location]">Location</label>
            <input id="listingLocationInput" type="text" name="Listing[location]" placeholder="Enter location" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a valid Location.
                </div>
        </div>
     </div>
        <div class="mb-3">
            <label for="Listing[country]">Country</label>
            <input id="listingCountryInput" type="text" name="Listing[country]" placeholder="Enter country" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a Country Name.
                </div>
        </div>
        <div class="mb-3">
            <label for="mapSearchInput" class="form-label">Choose address from map</label>
            <input id="mapSearchInput" type="text" class="form-control mb-2"
                placeholder="Search like Google Maps (Press Enter)">
            <div id="listingMapPicker" style="height: 23rem; border-radius: 0.8rem;"></div>
            <small class="text-muted">Search any address and press Enter, or drag marker to exact location.</small>
        </div>
        <input id="listingLatInput" type="hidden" name="Listing[coordinates][lat]">
        <input id="listingLngInput" type="hidden" name="Listing[coordinates][lng]">
        <br>
            <button class="btn btn-dark add-btn">Add</button>
            <br>
            <br>
    </form>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="/js/mapPicker.js"></script>
<script>
    initListingMapPicker({
        mapId: "listingMapPicker",
        searchInputId: "mapSearchInput",
        locationInputId: "listingLocationInput",
        countryInputId: "listingCountryInput",
        latInputId: "listingLatInput",
        lngInputId: "listingLngInput",
        initialLat: NaN,
        initialLng: NaN,
    });
</script>