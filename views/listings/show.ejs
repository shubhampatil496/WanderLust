<% layout("/layouts/boilerplate") %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <br>
    <div class="row">
        <div class="col-8 offset-3">
            <h3>
                <%= listingData.title %>
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card listing-card">
            <img src=<%=listingData.image.url %> class="card-img-top show-img" alt="...">
            <div class="card-body">
                <p class="card-text">Owned By : <i>
                        <%= listingData.owner.username %>
                    </i></p>
                <p class="card-text">
                    <%= listingData.description %>
                </p>
                <p class="card-text">&#8377;<%= listingData.price.toLocaleString("en-IN") %>
                </p>
                <p class="card-text">
                    <%= listingData.location %>
                </p>
                <p class="card-text">
                    <%= listingData.country %>
                </p>
            </div>
        </div>
        <br>

        <div class="col-6 offset-3 mb-4">
            <h5>Location on Map</h5>
            <div id="listingMap" style="height: 22rem; border-radius: 0.8rem;"></div>
        </div>
    </div>

    <% if(currUser && listingData.owner._id.equals(currUser._id)) { %>
        <div class="btns mb-3">
            <a href="/listings/<%= listingData.id %>/edit" class="btn btn-dark col-1 offset-3 edt-btn">Edit</a>
            <form action="/listings/<%= listingData.id %>?_method=delete" method="post">
                <button class="btn btn-dark offset-4">Delete</button>
            </form>
        </div>
        <% } %>

            <div class="col-8 offset-3 mb-3">
                <hr>
                <% if(currUser) { %>
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%= listingData.id %>/reviews" method="post" novalidate
                        class="needs-validation">
                  
                        <div class="mb-3 mt-3">
                            <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="5"
                                required></textarea>
                            <div class="invalid-feedback">
                                Please add Some Some Comments for Review
                            </div>
                        </div>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <% } %>

                        <% if(listingData.reviews.length > 0) { %>
                        <p><b>All Reviews</b></p>
                        <div class="row">
                            <% for(review of listingData.reviews) { %>
                                <div class="card col-5 ms-3 mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title"><b>@<%= review.author.username %></b></h5>
                                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>
                                    </div>
                                    <form
                                        action="/listings/<%= listingData.id %>/reviews/<%= review.id %>?_method=DELETE"
                                        method="post" class="mb-3 mt-2">
                                        <button class="btn btn-sm btn-dark">Delete</button>
                                    </form>
                                </div>
                                <% } %>
                        </div>
                        <% } %>

            </div>
            </div>

            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
            <script>
                (() => {
                    const mapNode = document.getElementById("listingMap");
                    if (!mapNode || typeof L === "undefined") return;

                    const fullAddress = <%- JSON.stringify(`${listingData.location}, ${listingData.country}`) %>;
                    const listingTitle = <%- JSON.stringify(listingData.title) %>;
                    const savedLat = <%= listingData.coordinates && listingData.coordinates.lat != null ? Number(listingData.coordinates.lat) : "NaN" %>;
                    const savedLng = <%= listingData.coordinates && listingData.coordinates.lng != null ? Number(listingData.coordinates.lng) : "NaN" %>;
                    const hasSavedCoordinates = Number.isFinite(savedLat) && Number.isFinite(savedLng);
                    const map = L.map("listingMap").setView(hasSavedCoordinates ? [savedLat, savedLng] : [20.5937, 78.9629], hasSavedCoordinates ? 13 : 4);

                    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                        maxZoom: 19,
                        attribution: "&copy; OpenStreetMap contributors",
                    }).addTo(map);

                    if (hasSavedCoordinates) {
                        L.marker([savedLat, savedLng])
                            .addTo(map)
                            .bindPopup(`<b>${listingTitle}</b><br>${fullAddress}`)
                            .openPopup();
                        return;
                    }

                    fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(fullAddress)}`)
                        .then((response) => response.json())
                        .then((results) => {
                            if (!Array.isArray(results) || results.length === 0) {
                                L.popup()
                                    .setLatLng([20.5937, 78.9629])
                                    .setContent("Exact location not found for this listing.")
                                    .openOn(map);
                                return;
                            }

                            const latitude = Number(results[0].lat);
                            const longitude = Number(results[0].lon);
                            map.setView([latitude, longitude], 13);

                            L.marker([latitude, longitude])
                                .addTo(map)
                                .bindPopup(`<b>${listingTitle}</b><br>${fullAddress}`)
                                .openPopup();
                        })
                        .catch(() => {
                            L.popup()
                                .setLatLng([20.5937, 78.9629])
                                .setContent("Unable to load location map right now.")
                                .openOn(map);
                        });
                })();
            </script>